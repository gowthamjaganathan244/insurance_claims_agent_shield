# Copy to .env.local. These settings are server-only; never use NEXT_PUBLIC_.
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_KEY=
# Local/single-process Node hosting; keep on a private persistent disk.
AUTH_DATABASE_PATH=.auth/sessions.sqlite
# Cognito pool/client/domain and the API origin are fixed in lib/auth/config.ts.
# No AWS access key, IAM credential, or Cognito client secret is required.
