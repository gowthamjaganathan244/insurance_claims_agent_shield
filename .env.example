# Copy to .env.local. These settings are server-only; never use NEXT_PUBLIC_.
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_KEY=
# Local/single-process Node hosting; keep on a private persistent disk.
AUTH_DATABASE_PATH=.auth/sessions.sqlite
# Cognito pool/client/domain and the API origin are fixed in lib/auth/config.ts.
# Cognito requires no IAM credentials or client secret.
# Monitoring requires a server-side temporary role/SSO session via the AWS SDK chain.
# Optional named temporary profile; never use NEXT_PUBLIC_ or commit credentials.
# AWS_PROFILE=agentshield-monitoring
# Comma-separated Cognito sub allowlist. Empty denies all monitoring users.
MONITORING_ALLOWED_SUBS=

# Set only after the isolated operations staging backend is approved and verified.
# Keep empty to show unavailable states; this is never a public browser credential.
OPERATIONS_API_ORIGIN=
# Optional isolated document-read API. Uploads continue using the existing Claims API.
DOCUMENTS_READ_API_ORIGIN=

# Serverless hosting (e.g. Vercel): set both to use Redis over HTTPS for sessions
# instead of SQLite. Vercel's Upstash integration may name them KV_REST_API_URL/TOKEN.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
